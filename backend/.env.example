# Gemini API Key (Dapatkan gratis di https://aistudio.google.com/)
GEMINI_API_KEY=masukkan_api_key_gemini_anda_di_sini

# Ollama Local LLM (Opsional jika ingin offline)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:1.5b

# Pilihan Provider:
# 'auto'   : Pakai Gemini, jika limit/offline otomatis fallback ke Ollama Qwen lokal
# 'ollama' : Selalu pakai Ollama Qwen lokal (100% offline)
# 'gemini' : Selalu pakai Gemini API
LLM_PROVIDER=auto
